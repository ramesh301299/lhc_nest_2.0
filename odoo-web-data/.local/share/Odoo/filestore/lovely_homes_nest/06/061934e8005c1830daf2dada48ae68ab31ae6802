 .o_loading_indicator.lhc-loader{position: fixed; inset: 0; top: 0; right: 0; bottom: 0; left: 0; width: auto; height: auto; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; z-index: 1085; display: -webkit-box; display: -webkit-flex; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0;}.lhc-loader-box{display: -webkit-box; display: -webkit-flex; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; -webkit-flex-direction: column; flex-direction: column; align-items: center; gap: 18px; padding: 34px 44px; border-radius: 14px; background: #111B30; border: 1px solid rgba(183, 144, 91, 0.34); box-shadow: 0 24px 60px -16px rgba(17, 27, 48, 0.45), 0 4px 12px rgba(17, 27, 48, 0.22);}.lhc-loader-mark{position: relative; width: 68px; height: 68px; display: -webkit-box; display: -webkit-flex; display: flex; align-items: center; justify-content: center; border-radius: 18px; background: #FAF9F6; box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.5);}.lhc-loader-mark img{width: 74%; height: 74%; object-fit: contain; display: block; animation: lhc-loader-breathe 1800ms cubic-bezier(0.4, 0, 0.2, 1) infinite;}.lhc-loader-ring{position: absolute; inset: -9px; border-radius: 22px; border: 3px solid rgba(183, 144, 91, 0.22); border-top-color: #B7905B; border-right-color: #B7905B; animation: lhc-loader-spin 900ms linear infinite;}.lhc-loader-text{font-size: 12.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: #cfad7e; display: -webkit-inline-box; display: -webkit-inline-flex; display: inline-flex; align-items: baseline;}.lhc-loader-dots i{display: inline-block; font-style: normal; animation: lhc-loader-dot 1400ms ease-in-out infinite;}.lhc-loader-dots i::before{content: ".";}.lhc-loader-dots i:nth-child(2){animation-delay: 200ms;}.lhc-loader-dots i:nth-child(3){animation-delay: 400ms;}.lhc-loader-count{font-size: 11px; color: rgba(255, 255, 255, 0.55); letter-spacing: .08em;}@key