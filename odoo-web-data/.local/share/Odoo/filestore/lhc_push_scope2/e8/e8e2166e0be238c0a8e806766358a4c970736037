            <t t-else="">
                <div class="o_lhc_head">
                    <div>
                        <h1>Personal Withdrawals</h1>
                    </div>
                    <button class="btn btn-primary o_lhc_wd_new" t-on-click="() =&gt; this.openForm()">
                        <i class="fa fa-plus" aria-hidden="true"/> Record Withdrawal
