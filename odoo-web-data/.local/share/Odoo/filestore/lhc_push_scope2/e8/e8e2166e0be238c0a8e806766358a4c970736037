registerTemplate("zeb_notification.NotificationMenu", `/zeb_notification/static/src/systray/zeb_notification_menu.xml`, `<t t-name="zeb_notification.NotificationMenu" xml:space="preserve">
        <Dropdown position="'bottom-end'" state="dropdown" beforeOpen.bind="onBeforeOpen" menuClass="'p-0 o-zeb-notification-menu'">
            <button class="dropdown-toggle o-dropdown--no-caret o-zeb-notification-toggle" t-att-class="{ 'o-zeb-has-unread': notif.unreadCount }" title="Notifications" aria-label="Notifications">

                <i t-attf-class="fa fa-lg {{ notif.unreadCount ? 'fa-bell o-zeb-bell-ring' : 'fa-bell-o' }}" role="img"/>
                <span t-if="notif.unreadCount" class="o-zeb-notification-counter badge rounded-pill" t-esc="counterText"/>
            </button>
            <t t-set-slot="content">
                <div class="o-zeb-notification-panel d-flex flex-column">

                    <div class="o-zeb-notification-header d-flex align-items-center px-3 py-2 border-bottom">
                        <span class="o-zeb-notification-title fw-bold flex-grow-1">Notifications</span>
                        <a href="#" class="small me-2" t-att-class="{ 'o-zeb-link-disabled': !notif.unreadCount }" t-on-click.prevent="onMarkAllRead">Mark all read</a>
                        <button class="btn btn-light btn-sm border-0" title="View all notifications" aria-label="View all notifications" t-on-click="openViewAll">
                            <i class="fa fa-cog" role="img"/>
                        </button>
                    </div>

                    <div class="px-3 py-2 border-bottom">
                        <input type="text" class="form-control form-control-sm" placeholder="Search notifications..." t-att-value="state.search" t-on-keyup="onSearchInput"/>
                    </div>

                    <div class="o-zeb-notification-filters d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                        <button class="btn btn-sm rounded-pill" t-att-class="notif.filter === 'all' ? 'btn-primary' : 'btn-light'" t-on-click="() =&gt; this.setFilter('all')">All</button>
                        <button class="btn btn-sm rounded-pill" t-att-class="notif.filter === 'unread' ? 'btn-primary' : 'btn-light'" t-on-click="() =&gt; this.setFilter('unread')">
                            Unread
                            <span t-if="notif.unreadCount" class="badge rounded-pill text-bg-secondary ms-1" t-esc="counterText"/>
                        </button>
                    </div>

                    <div class="o-zeb-notification-list flex-grow-1 overflow-auto">

                        <div t-if="notif.loading and !notif.items.length" class="d-flex align-items-center justify-content-center py-5 text-muted">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x" role="img" aria-label="Loading"/>
                        </div>
                        <t t-elif="notif.items.length">
                            <t t-foreach="notif.items" t-as="item" t-key="item.id">
                                <div class="o-zeb-notification-item d-flex align-items-start px-3 py-2 cursor-pointer" t-att-class="{ 'o-zeb-unread': !item.is_read }" t-on-click="() =&gt; this.onClickItem(item)">

                                    <div t-attf-class="o-zeb-notification-icon o-zeb-severity-{{ item.severity || 'info' }} rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0">
                                        <i t-attf-class="fa {{ item.icon || 'fa-bell' }}" role="img"/>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="o-zeb-notification-item-title fw-bold text-truncate" t-esc="item.title"/>
                                        <div t-if="item.message" class="o-zeb-notification-message text-muted small" t-esc="item.message"/>
                                        <div class="o-zeb-notification-meta text-muted small text-truncate">
                                            <t t-if="item.record_name">
                                                <span t-esc="item.record_name"/>
                                                <span> · </span>
                                            </t>
                                            <span t-esc="item.date"/>
                                        </div>
                                    </div>

                                    <button t-if="!item.is_read" class="o-zeb-notification-dot btn p-0 ms-2 flex-shrink-0" title="Mark as read" aria-label="Mark as read" t-on-click.stop="() =&gt; this.onMarkRead(item)"/>
                                </div>
                            </t>

                            <button t-if="notif.items.length lt notif.total" class="btn btn-link btn-sm w-100 py-2" t-on-click.stop="onLoadMore">Load more</button>
                        </t>

                        <div t-else="" class="o-zeb-notification-empty d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                            <i class="fa fa-bell-slash-o fa-2x mb-2" role="img" aria-label="No notifications"/>
                            <span>No notifications</span>
                        </div>
                    </div>

                    <a href="#" class="o-zeb-notification-footer text-center text-primary small py-2 border-top" t-on-click.prevent="openViewAll">View all notifications</a>
                </div>
            </t>
        </Dropdown>
