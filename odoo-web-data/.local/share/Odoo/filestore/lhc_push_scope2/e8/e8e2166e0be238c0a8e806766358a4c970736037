                                    </t> ·
                                    Withdrawn <t t-esc="formatAmount(state.data.holdings_total.withdrawn)"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div t-if="!state.data.holdings.length" class="o_lhc_wd_holdings_empty">
