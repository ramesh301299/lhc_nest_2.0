                    </div>
                </div>


                <div class="o_lhc_wd_panel">
                    <div class="o_lhc_wd_panel_head">
                        <span class="o_lhc_wd_panel_title">📗 Withdrawal History</span>
                    </div>

                    <div class="o_lhc_wd_filters">
