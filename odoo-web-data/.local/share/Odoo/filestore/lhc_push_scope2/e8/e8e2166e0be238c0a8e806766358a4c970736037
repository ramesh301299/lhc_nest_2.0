                            <option t-foreach="state.data.entities" t-as="e" t-key="e.id" t-att-value="e.id" t-att-selected="isEntity(e.id)" t-esc="e.name"/>
                        </select>
                        <label>From:</label>
                        <input type="date" class="form-control form-control-sm" t-model="state.date_from"/>
                        <label>To:</label>
                        <input type="date" class="form-control form-control-sm" t-model="state.date_to"/>
                        <button class="btn btn-sm btn-link" t-on-click="() =&gt; this.clearDates()" t-if="state.date_from or state.date_to">Clear</button>
                    </div>

                    <div t-if="state.data.rows.length" class="o_lhc_table_wrap">
                        <table class="table o_lhc_table o_lhc_wd_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Name</th>
                                    <th class="text-end">Amount</th>
                                    <th>Purpose / Note</th>
                                    <th>Entered By</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.data.rows" t-as="row" t-key="row.id">
                                    <td t-esc="row.date"/>
                                    <td>
                                        <span t-attf-class="o_lhc_pill o_lhc_pill_{{ pillColor(row.entity_id) }}" t-esc="row.name"/>
                                    </td>
                                    <td class="text-end o_lhc_wd_amt" t-esc="formatAmount(row.amount)"/>
                                    <td t-esc="row.note"/>
                                    <td class="o_lhc_wd_by" t-esc="row.entered_by"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div t-else="" class="o_lhc_state o_lhc_state_empty">
                        <div class="o_lhc_state_icon">📗</div>
                        <div class="o_lhc_state_title">No withdrawals for this filter</div>
                        <div class="o_lhc_state_text">Change the Name or Period, or record a new withdrawal.</div>
                    </div>
                </div>
            </t>
        </div>
    </t>


    `);
