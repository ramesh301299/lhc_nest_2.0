                        <div class="o_lhc_wd_tile_body">
                            <div class="o_lhc_card_label" t-esc="card.name"/>
                            <div class="o_lhc_card_value" t-esc="formatAmount(card.total)"/>
                            <div class="o_lhc_card_sub">This financial year</div>
                        </div>
                    </div>
                </div>


                <div class="o_lhc_wd_panel o_lhc_wd_holdings">
