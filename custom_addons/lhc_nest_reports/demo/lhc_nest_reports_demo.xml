<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      The statutory and owner-facing side.

      Everything the dashboard and the GST / TDS reports read is computed from
      the receipts and agreements in the other demo files. What is left is the
      money that leaves: remittances, auditor fees and owner withdrawals, none
      of which is derivable from a receipt.

      Amounts are set against the GST entity only. Spec §3 makes Soundarajan
      Kumar the sole GST-registered lessor, so a remittance recorded for any
      other entity would be describing a return that is never filed.
    -->

    <!-- ==============================================================
         GST REMITTANCE — what was actually paid to the department,
         against what the receipts say was collected.
         ============================================================== -->

    <record id="demo_gst_payment_prev" model="lhc.gst.payment">
        <field name="entity_id" ref="lhc_nest.entity_soundarajan"/>
        <field name="period" eval="(DateTime.today() - relativedelta(months=1)).strftime('%B %Y')"/>
        <field name="payment_date" eval="(DateTime.today() - relativedelta(day=20)).strftime('%Y-%m-%d')"/>
        <field name="amount">8910</field>
        <field name="challan">CIN/IOB/24091120/0771</field>
    </record>

    <record id="demo_gst_payment_older" model="lhc.gst.payment">
        <field name="entity_id" ref="lhc_nest.entity_soundarajan"/>
        <field name="period" eval="(DateTime.today() - relativedelta(months=2)).strftime('%B %Y')"/>
        <field name="payment_date" eval="(DateTime.today() - relativedelta(months=1, day=20)).strftime('%Y-%m-%d')"/>
        <field name="amount">8910</field>
        <field name="challan">CIN/IOB/24081120/0663</field>
    </record>

    <!-- ==============================================================
         AUDITOR FEES — a cost of being GST-registered, and the reason
         the GST summary carries a fee line at all.
         ============================================================== -->

    <record id="demo_auditor_fee_q1" model="lhc.auditor.fee">
        <field name="amount">15000</field>
        <field name="date" eval="(DateTime.today() - relativedelta(months=4, day=15)).strftime('%Y-%m-%d')"/>
        <field name="note">GSTR-1 / GSTR-3B filing, quarter 1.</field>
    </record>

    <record id="demo_auditor_fee_q2" model="lhc.auditor.fee">
        <field name="amount">15000</field>
        <field name="date" eval="(DateTime.today() - relativedelta(months=1, day=15)).strftime('%Y-%m-%d')"/>
        <field name="note">GSTR-1 / GSTR-3B filing, quarter 2.</field>
    </record>

    <!-- ==============================================================
         OWNER WITHDRAWALS — one per entity that actually collects, so
         the profitability report has a distribution to net off and not
         just a collection total.
         ============================================================== -->

    <record id="demo_withdrawal_kumar" model="lhc.withdrawal">
        <field name="entity_id" ref="lhc_nest.entity_kumar"/>
        <field name="amount">40000</field>
        <field name="date" eval="(DateTime.today() - relativedelta(day=12)).strftime('%Y-%m-%d')"/>
        <field name="note">Monthly drawing.</field>
    </record>

    <record id="demo_withdrawal_soundarajan" model="lhc.withdrawal">
        <field name="entity_id" ref="lhc_nest.entity_soundarajan"/>
        <field name="amount">75000</field>
        <field name="date" eval="(DateTime.today() - relativedelta(day=14)).strftime('%Y-%m-%d')"/>
        <field name="note">Monthly drawing, net of the GST remittance.</field>
    </record>

    <record id="demo_withdrawal_vijila" model="lhc.withdrawal">
        <field name="entity_id" ref="lhc_nest.entity_vijila"/>
        <field name="amount">25000</field>
        <field name="date" eval="(DateTime.today() - relativedelta(months=1, day=12)).strftime('%Y-%m-%d')"/>
        <field name="note">Drawing against the B-201 collection.</field>
    </record>

</odoo>
