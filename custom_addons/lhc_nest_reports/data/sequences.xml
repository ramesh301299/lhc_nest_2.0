<?xml version="1.0" encoding="utf-8"?>
<!--
  Document sequences for this addon.

  Split out of the original data/sequences.xml so numbering ships with the
  model that consumes it. noupdate="1" is deliberate: an upgrade must never
  reset number_next, or the next receipt reuses a number already issued.
-->
<odoo noupdate="1">

    <record id="seq_lhc_withdrawal" model="ir.sequence">
        <field name="name">LHC Withdrawal</field>
        <field name="code">lhc.withdrawal</field>
        <field name="prefix">WD-</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_lhc_gst_payment" model="ir.sequence">
        <field name="name">LHC GST Payment</field>
        <field name="code">lhc.gst.payment</field>
        <field name="prefix">GSTP-</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_lhc_auditor_fee" model="ir.sequence">
        <field name="name">LHC Auditor Fee</field>
        <field name="code">lhc.auditor.fee</field>
        <field name="prefix">AUD-</field>
        <field name="padding">4</field>
    </record>

</odoo>
