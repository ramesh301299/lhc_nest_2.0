<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="lhc_nest_theme.Sidebar">
        <t t-if="isActive">
            <!-- Backdrop for the off-canvas state below the breakpoint. -->
            <div class="lhc-sidebar-overlay"
                 t-att-class="{ 'lhc-open': state.open }"
                 t-on-click="closeSidebar"/>

            <aside class="lhc-sidebar" t-att-class="{ 'lhc-open': state.open }">

                <!-- Brand lockup -->
                <!-- The real monogram from the frozen brand pack, on an
                     ivory tile. The mark is drawn in navy and gold on
                     transparency, so placed straight onto the navy rail its
                     "LHC" would vanish — the tile is the ground it was
                     designed against, not decoration.

                     The wordmark's two-tone is carried in text rather than as
                     an image: at rail width the SVG wordmark would be ~14px
                     tall and unreadable, and text stays crisp and ellipsises
                     when the rail narrows. -->
                <div class="lhc-brand">
                    <div class="lhc-brand-mark" aria-hidden="true">
                        <img src="/lhc_nest_theme/static/src/img/lhc_monogram.svg"
                             alt="" class="lhc-brand-logo"/>
                    </div>
                    <!-- SET AS TEXT, not drawn as the wordmark SVG.
                         The frozen lockup is letterhead artwork: "LHCNEST" is
                         about a fifth of its height and the strapline about a
                         sixteenth. At rail width — roughly 200px for this
                         block — the strapline rendered around 4px tall and
                         could not be read. Type has no such ceiling: it stays
                         crisp at any size, takes the two-tone directly, and
                         ellipsises or wraps when the rail narrows. -->
                    <div class="lhc-brand-txt">
                        <div class="lhc-brand-name">
                            <span class="lhc-brand-lhc">LHC</span><span class="lhc-brand-nest">NEST</span>
                        </div>
                        <div class="lhc-brand-sub">Rental Property Management</div>
                    </div>
                </div>

                <!-- Signed-in user. Identity comes from the session; the role
                     is a label for the groups the server already applied. -->
                <div class="lhc-userbox">
                    <div class="lhc-user-card">
                        <div class="lhc-avatar" aria-hidden="true" t-esc="userInitial"/>
                        <div class="lhc-user-meta">
                            <div class="lhc-user-name" t-esc="userName"/>
                            <div class="lhc-role-badge"
                                 t-att-class="state.isAdmin ? 'lhc-role-admin' : 'lhc-role-acct'"
                                 t-esc="roleLabel"/>
                        </div>
                        <a href="/web/session/logout" class="lhc-logout"
                           title="Log out" aria-label="Log out"><i class="fa fa-sign-out" aria-hidden="true"/></a>
                    </div>
                </div>

                <!-- Navigation, rendered from ir.ui.menu -->
                <nav class="lhc-nav" aria-label="LHC NEST">
                    <t t-foreach="sections" t-as="section" t-key="section.id">

                        <!-- A menu with an action is a destination. -->
                        <t t-if="!section.isGroup">
                            <button type="button"
                                    class="lhc-nav-item"
                                    t-att-class="{
                                        'lhc-active': isMenuActive(section),
                                        'lhc-highlight': section.highlight,
                                    }"
                                    t-att-data-menu-xmlid="section.xmlid"
                                    t-on-click="() => this.onMenuClick(section)">
                                <i t-att-class="'lhc-ic fa ' + section.icon" aria-hidden="true"/>
                                <span class="lhc-nav-label" t-esc="section.name"/>
                            </button>
                        </t>

                        <!-- A menu without an action is a group header. -->
                        <t t-else="">
                            <div class="lhc-nav-group"
                                 t-att-class="{ 'lhc-collapsed': isCollapsed(section) }">
                                <button type="button"
                                        class="lhc-nav-group-header"
                                        t-att-aria-expanded="!isCollapsed(section)"
                                        t-on-click="() => this.toggleGroup(section)">
                                    <span class="lhc-chev" aria-hidden="true">▾</span>
                                    <span t-esc="section.name"/>
                                    <span class="lhc-group-dot"
                                          t-if="isCollapsed(section) and hasActiveChild(section)"
                                          aria-hidden="true"/>
                                </button>
                                <div class="lhc-nav-group-items">
                                  <div class="lhc-nav-group-inner">
                                    <t t-foreach="section.children" t-as="child" t-key="child.id">
                                        <button type="button"
                                                class="lhc-nav-item"
                                                t-att-class="{
                                                    'lhc-active': isMenuActive(child),
                                                    'lhc-highlight': child.highlight,
                                                }"
                                                t-att-data-menu-xmlid="child.xmlid"
                                                t-on-click="() => this.onMenuClick(child)">
                                            <i t-att-class="'lhc-ic fa ' + child.icon" aria-hidden="true"/>
                                            <span class="lhc-nav-label" t-esc="child.name"/>
                                        </button>
                                    </t>
                                  </div>
                                </div>
                            </div>
                        </t>

                    </t>
                    <!-- CLIENT VIEW — the customer-facing JS screens.
                         Each row opens lhc_client_view, which renders the real
                         Odoo model through the LHC design. Offered only when
                         the server sent this user the matching Odoo menu. -->
                    <t t-if="clientViews.length">
                        <div class="lhc-nav-divider" aria-hidden="true">
                            <span>Client View</span>
                        </div>
                        <t t-foreach="clientViews" t-as="view" t-key="view.key">
                            <button type="button"
                                    class="lhc-nav-item"
                                    t-att-class="{ 'lhc-active': isClientViewActive(view) }"
                                    t-att-data-client-view="view.key"
                                    t-on-click="() => this.openClientView(view)">
                                <i t-att-class="'lhc-ic fa ' + view.icon" aria-hidden="true"/>
                                <span class="lhc-nav-label" t-esc="view.label"/>
                            </button>
                        </t>
                    </t>

                    <!-- ODOO MENU — one entry holding every Odoo application
                         this user may open. Opens Odoo's own screens: the full
                         form, every field, every button. The developer and
                         back-office door, kept separate from the client views
                         above on purpose.

                         The list comes from menuService.getApps(), so it is
                         whatever the server grants — nothing is hardcoded, and
                         an uninstalled module contributes no entry. -->
                    <div class="lhc-nav-group lhc-nav-group-odoo"
                         t-if="odooApps.length"
                         t-att-class="{ 'lhc-collapsed': isCollapsed({ xmlid: '__odoo_menu__' }) }">
                        <button type="button"
                                class="lhc-nav-group-header lhc-odoo-header"
                                t-att-aria-expanded="!isCollapsed({ xmlid: '__odoo_menu__' })"
                                t-on-click="() => this.toggleGroup({ xmlid: '__odoo_menu__' })">
                            <span class="lhc-chev" aria-hidden="true">▾</span>
                            <i class="lhc-app-badge fa fa-cubes" aria-hidden="true"/>
                            <span class="lhc-nav-label">Odoo Menu</span>
                        </button>
                        <div class="lhc-nav-group-items">
                          <div class="lhc-nav-group-inner">
                            <t t-foreach="odooApps" t-as="app" t-key="app.id">
                                <button type="button"
                                        class="lhc-nav-item lhc-app-item lhc-nav-leaf"
                                        t-att-class="{ 'lhc-active': isAppActive(app) }"
                                        t-att-data-menu-xmlid="app.xmlid"
                                        t-on-click="() => this.openApp(app)">
                                    <span class="lhc-ic">
                                        <img t-if="app.webIconData"
                                             t-att-src="app.webIconData"
                                             class="lhc-app-icon" alt=""/>
                                        <i t-else="" class="fa fa-th-large" aria-hidden="true"/>
                                    </span>
                                    <span class="lhc-nav-label" t-esc="app.name"/>
                                </button>
                            </t>
                          </div>
                        </div>
                    </div>

                </nav>
            </aside>

            <!-- Off-canvas trigger. Hidden above the breakpoint by CSS. -->
            <button type="button" class="lhc-hamburger"
                    t-on-click="toggleSidebar"
                    aria-label="Toggle navigation"><i class="fa fa-bars" aria-hidden="true"/></button>
        </t>
    </t>

</templates>
