<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
      The create wizard's dialog.

      `t-inherit-mode="primary"` is the whole point of this file: it produces a
      NEW template that starts as a copy of Odoo's, rather than modifying
      `web.FormViewDialog` in place. Every record dialog in Odoo renders through
      that template — a one2many "Add a line", a many2one "Create and edit", the
      calendar's event popup — and none of them are create wizards. Only the
      component that names this template gets the class.

      The class lands on `.modal-content` (see `web.Dialog`), and dialog.scss
      keys the wizard chrome off it.
    -->
    <t t-name="lhc_nest_theme.CreateDialog"
       t-inherit="web.FormViewDialog"
       t-inherit-mode="primary">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="contentClass">'lhc-create-dialog'</attribute>
        </xpath>
    </t>

</templates>
