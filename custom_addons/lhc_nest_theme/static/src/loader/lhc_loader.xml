<?xml version="1.0" encoding="UTF-8" ?>
<!--
  LHC NEST — the loading overlay.

  Extends Odoo's own `web.LoadingIndicator` rather than inventing a trigger.
  That component already does the hard part: it listens on the RPC bus, counts
  in-flight non-silent requests, and only flips `state.show` once one has been
  running for 250ms. So the overlay appears while data is genuinely loading and
  not on every fast round-trip — which is precisely the "only for data loading
  time" behaviour asked for, and it comes for free.

  Replacing the span rather than wrapping it keeps `transition.className` on
  the root, so Odoo's own fade in/out still drives the animation.
-->
<templates xml:space="preserve">

    <t t-name="lhc_nest_theme.Loader"
       t-inherit="web.LoadingIndicator"
       t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_loading_indicator')]" position="replace">
            <div class="o_loading_indicator lhc-loader"
                 t-att-class="transition.className"
                 role="status"
                 aria-live="polite"
                 aria-busy="true">
                <div class="lhc-loader-box">
                    <div class="lhc-loader-mark">
                        <!-- The brand monogram IS the building: a roofed frame
                             with a window. No separate icon needed. -->
                        <img src="/lhc_nest_theme/static/src/img/lhc_monogram.svg" alt=""/>
                        <span class="lhc-loader-ring" aria-hidden="true"/>
                    </div>
                    <div class="lhc-loader-text">
                        Loading<span class="lhc-loader-dots" aria-hidden="true"><i/><i/><i/></span>
                    </div>
                    <!-- The in-flight request count, debug mode only, exactly
                         as Odoo's own indicator shows it. -->
                    <div class="lhc-loader-count" t-if="env.debug" t-esc="state.count"/>
                </div>
            </div>
        </xpath>
    </t>

</templates>
