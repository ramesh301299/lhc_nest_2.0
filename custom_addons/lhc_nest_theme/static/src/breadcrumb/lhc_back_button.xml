<?xml version="1.0" encoding="UTF-8" ?>
<!--
  A back button on every child screen.

  Odoo already ships one — but only for `env.isSmall`. On a desktop it shows
  the breadcrumb trail instead and expects the user to know that the greyed
  parent name is clickable. Going parent -> child and back is the single most
  common move in this product, so it gets an explicit control.

  Placement is deliberate: INSIDE `.o_breadcrumb`, which Odoo renders only when
  `collapsedBreadcrumbs.length || visiblePathBreadcrumbs.length` — that is, only
  when there is somewhere to go back TO. A root screen has neither, so no button
  appears and nothing has to test for it.

  `visiblePathBreadcrumbs` is `breadcrumbs.slice(-3, -1)`, so its last entry is
  always the immediate parent, whether or not earlier crumbs collapsed into the
  overflow dropdown. `onSelected` is the callback Odoo's own crumbs and its own
  small-screen back button already use, so this restores the parent controller
  through exactly the same path — no new navigation logic.
-->
<templates xml:space="preserve">

    <t t-name="lhc_nest_theme.BreadcrumbsBack"
       t-inherit="web.Breadcrumbs"
       t-inherit-mode="extension">
        <xpath expr="//ol[hasclass('breadcrumb')]" position="before">
            <t t-set="lhcParentCrumb" t-value="visiblePathBreadcrumbs.at(-1)"/>
            <button t-if="lhcParentCrumb"
                    type="button"
                    class="btn lhc-back-btn d-print-none"
                    aria-label="Back"
                    t-att-data-tooltip="'Back to ' + lhcParentCrumb.name"
                    t-on-click.prevent="lhcParentCrumb.onSelected">
                <i class="oi oi-arrow-left" aria-hidden="true"/>
                <span class="lhc-back-txt">Back</span>
            </button>
        </xpath>

        <!-- Odoo's own trail, hidden once the button is there.
             `.o_breadcrumb` lays its children out as a COLUMN on desktop
             (`flex-md-column`), so the trail sat on its own line between the
             button and the record's name — a stray "Units" link boxed above
             the title. The button already carries "go back", so the trail is
             two controls for one job; it is removed from the accessibility
             tree too rather than merely hidden, so it is not read out twice. -->
        <xpath expr="//ol[hasclass('breadcrumb')]" position="attributes">
            <attribute name="class">breadcrumb flex-nowrap text-nowrap lh-sm lhc-trail-hidden</attribute>
            <attribute name="aria-hidden">true</attribute>
        </xpath>
    </t>

</templates>
