<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick Entries hub.

  The existing "Quick Entries" menu is a parent with nine children and no
  action of its own. This gives it one: a client action rendering the
  mockup's card launcher. The nine children stay exactly where they are —
  the hub builds its cards from them, and they remain reachable directly.

  The menu is restored to having no action by the uninstall hook in
  __init__.py, so removing this module leaves the menu as it is today.
-->
<odoo>

    <record id="action_lhc_quick_entries" model="ir.actions.client">
        <field name="name">Quick Entries</field>
        <field name="tag">lhc_nest_theme.quick_entries</field>
        <field name="target">current</field>
    </record>

    <record id="lhc_nest.menu_lhc_quick" model="ir.ui.menu">
        <field name="action" ref="lhc_nest_theme.action_lhc_quick_entries"/>
    </record>

</odoo>
