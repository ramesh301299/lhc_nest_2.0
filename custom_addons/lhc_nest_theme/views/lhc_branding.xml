<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand identity: the favicon, the app icon, and the sign-in screen.

  The marks are the FROZEN brand pack (see static/src/img/) — outlined SVG for
  anything on screen, as the pack's README asks, so they stay sharp at any size
  and carry no external references.
-->
<odoo>

    <!-- =================================================================
         Favicon and app icon.

         Odoo's `web.layout` writes `x_icon or '/web/static/img/favicon.ico'`.
         `x_icon` is only set on a website page, so every backend and login
         page fell through to Odoo's own purple mark. Replacing the link
         outright covers all of them in one place.

         SVG first with the .ico as the fallback: a modern browser takes the
         vector and stays sharp on a HiDPI tab strip, everything else takes
         the 256px .ico.
         ================================================================= -->
    <template id="lhc_favicon" inherit_id="web.layout" name="LHC NEST favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="icon" type="image/svg+xml"
                  href="/lhc_nest_theme/static/src/img/favicon.svg"/>
            <link rel="alternate icon" type="image/x-icon"
                  href="/lhc_nest_theme/static/src/img/favicon.ico"/>
            <link rel="apple-touch-icon"
                  href="/lhc_nest_theme/static/src/img/apple-touch-icon.png"/>
        </xpath>
    </template>

    <!-- =================================================================
         The sign-in screen.

         Two attribute changes and one added line — the form itself, its
         fields, its CSRF token and every auth provider button are Odoo's and
         are not touched. login.scss does the rest.
         ================================================================= -->
    <template id="lhc_login_layout" inherit_id="web.login_layout" name="LHC NEST login">

        <!-- The ground is the whole viewport, so the hook has to be on <body>.
             Odoo sets `bg-100` here; ours replaces it because the two would
             otherwise fight over the page background. -->
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'o_lhc_login'"/>
        </xpath>

        <!-- Odoo pins the card to 300px with an inline style, which no
             stylesheet can outrank. Clearing the attribute hands the width
             back to the sheet, which sets a more comfortable 424px.

             NOTE the selector: this div's classes come from `t-attf-class`
             (it interpolates {{login_card_classes}}), so at parse time there
             is no static `class` attribute and `hasclass('o_database_list')`
             matches nothing — it fails the whole view with "cannot be located
             in parent view". Match on the attribute's text instead. -->
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="style"/>
        </xpath>

        <!-- The brand half.
             Everything here is decorative, so it is `aria-hidden` — a screen
             reader gets the form and nothing else, rather than having to walk
             past a logo and a strapline to reach the email field.

             The wordmark is set as TEXT rather than the SVG. The printed mark
             draws "LHC" in navy, which on this navy panel would simply
             disappear; as text the two-tone can be re-cut for a dark ground
             (white + gold) and it stays crisp at any size. The monogram DOES
             appear as its SVG, on an ivory tile — the light ground it was
             drawn against. -->
        <xpath expr="//div[hasclass('container')]" position="before">
            <aside class="o_lhc_login_brand" aria-hidden="true">
                <div class="o_lhc_login_brand_in">
                    <div class="o_lhc_login_tile">
                        <img src="/lhc_nest_theme/static/src/img/lhc_monogram.svg" alt=""/>
                    </div>
                    <div class="o_lhc_login_word">
                        <span class="o_lhc_w_lhc">LHC</span><span class="o_lhc_w_nest">NEST</span>
                    </div>
                    <div class="o_lhc_login_rule"></div>
                    <div class="o_lhc_login_strap">Rental Property Management</div>
                    <div class="o_lhc_login_group">LHC Groups</div>
                </div>
            </aside>
        </xpath>

        <!-- The wordmark itself, replacing `/web/binary/company_logo`.
             That route serves `res.company.logo`, which on a fresh database is
             Odoo's "Your logo" placeholder — so the first screen of the product
             was advertising an unset field. Pointing at the outlined SVG in
             this addon means the sign-in screen is correct out of the box, on
             any database, with no company record to configure first, and it
             stays sharp at any size.

             The company logo itself is deliberately NOT written here: that is
             the customer's data and it brands their invoices and emails, which
             is a separate decision from how this screen looks. -->
        <!-- `//img` on its own is WRONG here and was: this inherit adds the
             brand panel above, which contains an <img> of its own, so a bare
             `//img` matches THAT one first and replaces the monogram while
             leaving Odoo's placeholder untouched. Odoo builds the company-logo
             src with `t-attf-src` (it interpolates the dbname); the monogram
             uses a plain `src`, so the attribute name is what tells them
             apart. -->
        <xpath expr="//img[@t-attf-src]" position="replace">
            <div class="o_lhc_login_welcome">
                <!-- The banner lockup above the greeting.
                     This is the outlined SVG of the same wordmark the brand
                     pack ships as lhc_nest_banner.png — identical artwork at
                     the identical 3.57:1 lockup, but vector, so it stays sharp
                     on a HiDPI screen and at any pane width. The pack's own
                     README asks for the outlined SVG on web for exactly that
                     reason. It is drawn in navy and gold, which is what this
                     white pane was made for. -->
                <img src="/lhc_nest_theme/static/src/img/lhc_wordmark.svg"
                     alt="LHC NEST — Rental Property Management"
                     class="o_lhc_login_banner"/>
                <h1>Sign in</h1>
                <p>Welcome back. Enter your details to continue.</p>
            </div>
        </xpath>

        <!-- The strapline used to sit under the card. It now lives in the
             brand half, so it is not repeated here. -->
    </template>

</odoo>
