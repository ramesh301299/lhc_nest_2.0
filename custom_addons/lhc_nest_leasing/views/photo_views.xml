<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_photo_list" model="ir.ui.view">
        <field name="name">lhc.unit.photo.list</field>
        <field name="model">lhc.unit.photo</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="unit_id"/>
                <field name="agreement_id"/>
                <field name="event_type"/>
                <field name="room_label"/>
                <field name="uploaded_date"/>
                <field name="image" widget="image" options="{'size':[50,50]}"/>
                <field name="damage_noted"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_lhc_photo" model="ir.actions.act_window">
        <field name="name">Move-in / Move-out Photos</field>
        <field name="res_model">lhc.unit.photo</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_lhc_photo_kanban" model="ir.ui.view">
        <field name="name">lhc.unit.photo.kanban.lhc</field>
        <field name="model">lhc.unit.photo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="room_label" records_draggable="0" group_create="false">
                <field name="damage_noted"/>
                <field name="event_type"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <span class="lhc-card-title"><field name="room_label"/></span>
                                <field name="event_type" widget="badge"
                                       decoration-info="event_type == 'move_in'"
                                       decoration-warning="event_type == 'move_out'"/>
                            </div>
                            <field name="image" widget="image" class="w-100 mb-2"
                                   options="{'size': [0, 140]}"/>
                            <div class="lhc-card-sub">
                                <field name="unit_id"/> · <field name="uploaded_date"/>
                            </div>
                            <span class="badge text-bg-danger mt-1"
                                  t-if="record.damage_noted.raw_value">Damage noted</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
