<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_advance_list" model="ir.ui.view">
        <field name="name">lhc.advance.installment.list</field>
        <field name="model">lhc.advance.installment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="agreement_id"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="installment_no"/>
                <field name="amount" sum="Collected"/>
                <field name="date"/>
                <field name="mode"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="action_lhc_advance" model="ir.actions.act_window">
        <field name="name">Advance &amp; Deposits</field>
        <field name="res_model">lhc.advance.installment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
