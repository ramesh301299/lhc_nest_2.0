<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_agreement_list" model="ir.ui.view">
        <field name="name">lhc.agreement.list</field>
        <field name="model">lhc.agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="primary_tenant_id"/>
                <field name="billing_entity_id"/>
                <field name="payable_rent"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-warning="state=='notice'"
                       decoration-muted="state in ('closed','cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_agreement_form" model="ir.ui.view">
        <field name="name">lhc.agreement.form</field>
        <field name="model">lhc.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_renew_wizard" type="object" string="🔄 Renew"
                            class="btn-warning" groups="lhc_nest.group_lhc_admin"
                            invisible="state not in ('active','notice')"/>
                    <button name="action_open_notice_wizard" type="object" string="📢 Give Notice"
                            invisible="state != 'active'"/>
                    <button name="%(action_report_lhc_agreement)d" type="action"
                            string="🖨️ Print Agreement" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,notice,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state != 'draft'">
                        Bank account and billing entity lock for this unit once saved, until the unit becomes Vacant.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Template &amp; Unit">
                            <field name="template_id"/>
                            <field name="property_id"/>
                            <field name="unit_id"/>
                            <field name="primary_tenant_id"/>
                        </group>
                        <group string="Billing &amp; Bank">
                            <field name="billing_entity_id"
                                   readonly="state in ('active','notice','closed')"/>
                            <field name="gst_applicable"/>
                            <field name="bank_label"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates &amp; Terms">
                            <field name="due_day"/>
                            <field name="notice_period_days"/>
                            <field name="lockin_months"/>
                            <field name="default_breach_text"/>
                        </group>
                        <group string="Agreed Escalation">
                            <field name="escalation_pct"/>
                            <field name="escalation_frequency"/>
                            <field name="deposit_escalates"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Rent">
                            <field name="payable_rent"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Advance / Deposit">
                            <field name="advance_total"/>
                            <field name="advance_collected"/>
                            <field name="advance_balance"/>
                        </group>
                    </group>
                    <group invisible="state != 'notice'" string="Notice">
                        <field name="notice_date"/>
                        <field name="notice_reason"/>
                        <field name="expected_vacate_date"/>
                    </group>
                    <notebook>
                        <page string="Rent Structure (versions)">
                            <p class="text-muted">Renewal creates a NEW version — old versions are preserved, never edited in place.</p>
                            <field name="version_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence"/>
                                    <field name="base_rent"/>
                                    <field name="discount"/>
                                    <field name="service_charge"/>
                                    <field name="payable_rent"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="escalation_method"/>
                                    <field name="is_current"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Joint Tenants">
                            <field name="joint_tenant_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="mobile"/>
                                    <field name="relation"/>
                                    <field name="aadhaar"/>
                                    <field name="pan"/>
                                    <field name="id_doc" filename="id_doc_filename"/>
                                    <field name="id_doc_filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fixtures (read-only)">
                            <field name="fixture_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="purchase_date"/>
                                    <field name="cost_before_gst"/>
                                    <field name="move_in_condition"/>
                                </list>
                            </field>
                        </page>
                        <page string="Advance Installments">
                            <field name="installment_ids">
                                <list editable="bottom">
                                    <field name="installment_no"/>
                                    <field name="amount"/>
                                    <field name="date"/>
                                    <field name="mode"/>
                                    <field name="reference"/>
                                </list>
                            </field>
                        </page>
                        <page string="Move-in / Move-out Photos">
                            <field name="photo_ids" context="{'default_unit_id': unit_id}">
                                <list editable="bottom">
                                    <field name="event_type"/>
                                    <field name="room_label"/>
                                    <field name="uploaded_date"/>
                                    <field name="image" widget="image" options="{'size':[60,60]}"/>
                                    <field name="damage_noted"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="agreement_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhc_agreement" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">lhc.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Renewal Reminders: agreements expiring soon -->
    <record id="action_lhc_renewals" model="ir.actions.act_window">
        <field name="name">Renewal Reminders</field>
        <field name="res_model">lhc.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','active')]</field>
        <field name="context">{'search_default_expiring': 1}</field>
    </record>

    <record id="view_lhc_agreement_search" model="ir.ui.view">
        <field name="name">lhc.agreement.search</field>
        <field name="model">lhc.agreement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="primary_tenant_id"/>
                <filter name="active_state" string="Active" domain="[('state','=','active')]"/>
                <filter name="notice" string="Notice Given" domain="[('state','=','notice')]"/>
                <filter name="expiring" string="Expiring in 30 days"
                        domain="[('end_date','&lt;=', (context_today() + relativedelta(days=30))), ('end_date','&gt;=', context_today())]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_entity" string="Entity" context="{'group_by':'billing_entity_id'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Renew wizard -->
    <record id="view_lhc_renew_wizard_form" model="ir.ui.view">
        <field name="name">lhc.renew.wizard.form</field>
        <field name="model">lhc.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Agreement">
                <group>
                    <field name="agreement_id" invisible="1"/>
                    <field name="current_payable" readonly="1"/>
                    <field name="method"/>
                    <field name="pct" invisible="method != 'A'"/>
                    <field name="fixed_amount" invisible="method != 'C'"/>
                    <field name="base_rent" invisible="method not in ('B','D')"/>
                    <field name="discount" invisible="method not in ('B','D')"/>
                    <field name="service_charge" invisible="method not in ('B','D')"/>
                    <field name="reason" invisible="method != 'D'"
                           required="method == 'D'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm Renewal" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Give Notice wizard -->
    <record id="view_lhc_notice_wizard_form" model="ir.ui.view">
        <field name="name">lhc.notice.wizard.form</field>
        <field name="model">lhc.notice.wizard</field>
        <field name="arch" type="xml">
            <form string="Give Vacate Notice">
                <group>
                    <field name="agreement_id" invisible="1"/>
                    <field name="notice_date"/>
                    <field name="notice_period_days" readonly="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm Notice" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
