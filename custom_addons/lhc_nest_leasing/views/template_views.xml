<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_template_list" model="ir.ui.view">
        <field name="name">lhc.agreement.template.list</field>
        <field name="model">lhc.agreement.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="applies_to"/>
                <field name="clause_count"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_template_form" model="ir.ui.view">
        <field name="name">lhc.agreement.template.form</field>
        <field name="model">lhc.agreement.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Clause text is placeholder structure only — real legal wording must be supplied before go-live (spec §5.7).
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Template Name"/></h1></div>
                    <group>
                        <field name="applies_to"/>
                        <field name="is_default"/>
                        <field name="default_breach_text"/>
                    </group>
                    <field name="clause_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="body"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhc_template" model="ir.actions.act_window">
        <field name="name">Agreement Templates</field>
        <field name="res_model">lhc.agreement.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_lhc_template_kanban" model="ir.ui.view">
        <field name="name">lhc.agreement.template.kanban.lhc</field>
        <field name="model">lhc.agreement.template</field>
        <field name="arch" type="xml">
            <kanban records_draggable="0">
                <field name="is_default"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <span class="lhc-card-title"><field name="name"/></span>
                                <span class="badge text-bg-success"
                                      t-if="record.is_default.raw_value">Default</span>
                            </div>
                            <div class="lhc-card-row">
                                <span class="lhc-k">Applies To</span>
                                <span class="lhc-v"><field name="applies_to"/></span>
                            </div>
                            <div class="lhc-card-row">
                                <span class="lhc-k">Clause Sections</span>
                                <span class="lhc-v"><field name="clause_count"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
