<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Record rules for this addon's models.

      noupdate="0", deliberately. A rule is the security model, not an
      administrator preference: a correction to one has to reach databases that
      already installed the old version. ir.model.access.csv already behaves
      this way — Odoo always reloads it.

      global="True" means the rule is ANDed with every other rule regardless of
      group, so no group membership can widen it. Each model's company scoping
      ships with the model rather than in one project-wide file, so removing an
      addon removes exactly its own rules.
    -->
    <data noupdate="0">
        <record id="rule_lhc_agreement_company" model="ir.rule">
            <field name="name">Agreement: multi-company</field>
            <field name="model_id" ref="model_lhc_agreement"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_agreement_version_company" model="ir.rule">
            <field name="name">Agreement Version: multi-company</field>
            <field name="model_id" ref="model_lhc_agreement_version"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_joint_tenant_company" model="ir.rule">
            <field name="name">Joint Tenant: multi-company</field>
            <field name="model_id" ref="model_lhc_joint_tenant"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_agreement_template_company" model="ir.rule">
            <field name="name">Agreement Template: multi-company</field>
            <field name="model_id" ref="model_lhc_agreement_template"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_agreement_template_clause_company" model="ir.rule">
            <field name="name">Agreement Template Clause: multi-company</field>
            <field name="model_id" ref="model_lhc_agreement_template_clause"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_vacate_company" model="ir.rule">
            <field name="name">Vacate Checklist: multi-company</field>
            <field name="model_id" ref="model_lhc_vacate"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_vacate_line_company" model="ir.rule">
            <field name="name">Vacate Line: multi-company</field>
            <field name="model_id" ref="model_lhc_vacate_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_unit_photo_company" model="ir.rule">
            <field name="name">Unit Photo: multi-company</field>
            <field name="model_id" ref="model_lhc_unit_photo"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_advance_installment_company" model="ir.rule">
            <field name="name">Advance Installment: multi-company</field>
            <field name="model_id" ref="model_lhc_advance_installment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
