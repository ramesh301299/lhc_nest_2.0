<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lhc_agreement" model="ir.actions.report">
        <field name="name">Agreement Document</field>
        <field name="model">lhc.agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lhc_nest.report_agreement</field>
        <field name="report_file">lhc_nest.report_agreement</field>
        <field name="binding_model_id" ref="model_lhc_agreement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_agreement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rec">
                <t t-set="cv" t-value="rec.current_version_id"/>
                <t t-set="e" t-value="rec.billing_entity_id"/>
                <t t-set="ten" t-value="rec.primary_tenant_id"/>
                <t t-set="u" t-value="rec.unit_id"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-family:Arial,sans-serif;color:#1e293b;">
                        <h2 style="text-align:center;color:#1c2e5c;text-transform:uppercase;">
                            <t t-out="rec.template_id.name"/></h2>
                        <p style="text-align:center;font-size:12px;color:#64748b;">
                            Agreement No. <t t-out="rec.name"/> · Version <t t-out="cv.sequence if cv else 1"/></p>

                        <h4 style="color:#1c2e5c;">1. Lessor (Landlord)</h4>
                        <p style="font-size:12px;line-height:1.6;">
                            <strong><t t-out="e.name"/></strong><t t-if="e.relation">, <t t-out="e.relation"/></t>
                            <t t-if="e.age">, Age <t t-out="e.age"/></t>.
                            PAN: <t t-out="e.pan or '—'"/><t t-if="e.gst_applicable">, GSTIN: <t t-out="e.gstin"/></t>.
                            Mobile: <t t-out="e.mobile or '—'"/>.<br/>
                            Address: <t t-out="e.residential_address or '—'"/>.<br/>
                            Bank: <t t-out="e.bank_holder_name or e.name"/>, A/C <t t-out="e.bank_account_no or '—'"/>,
                            <t t-out="e.bank_name or ''"/> <t t-out="e.bank_branch or ''"/>
                            <t t-if="e.bank_branch_address">(<t t-out="e.bank_branch_address"/>)</t>,
                            IFSC <t t-out="e.bank_ifsc or '—'"/>.
                        </p>

                        <h4 style="color:#1c2e5c;">2. Lessee (Tenant)</h4>
                        <p style="font-size:12px;line-height:1.6;">
                            <t t-if="ten.tenant_type == 'company'">
                                <strong><t t-out="ten.company_name or ten.name"/></strong>, GSTIN <t t-out="ten.gstin or '—'"/>,
                                represented by <t t-out="ten.rep_name or '—'"/> (<t t-out="ten.rep_relation or ''"/>),
                                PAN <t t-out="ten.rep_pan or '—'"/>, Mobile <t t-out="ten.rep_mobile or '—'"/>.
                            </t>
                            <t t-else="">
                                <strong><t t-out="ten.name"/></strong><t t-if="ten.relation">, <t t-out="ten.relation"/></t>
                                <t t-if="ten.age">, Age <t t-out="ten.age"/></t>.
                                PAN <t t-out="ten.pan or '—'"/>, Aadhaar <t t-out="ten.aadhaar or '—'"/>, Mobile <t t-out="ten.mobile or '—'"/>.<br/>
                                Present Address: <t t-out="ten.present_address or '—'"/>.
                            </t>
                        </p>
                        <t t-if="rec.joint_tenant_ids">
                            <p style="font-size:12px;"><strong>Joint Tenants:</strong>
                                <t t-foreach="rec.joint_tenant_ids" t-as="jt">
                                    <t t-out="jt.name"/> (<t t-out="jt.relation or ''"/>, PAN <t t-out="jt.pan or '—'"/>)<t t-if="not jt_last">; </t>
                                </t>
                            </p>
                        </t>

                        <h4 style="color:#1c2e5c;">3. Premises</h4>
                        <p style="font-size:12px;line-height:1.6;">
                            Unit <t t-out="u.code"/>, <t t-out="rec.property_id.name"/>
                            <t t-if="u.door_no">, Door No. <t t-out="u.door_no"/></t>.
                            Area: <t t-out="u.super_builtup_area or u.area_sqft"/> sqft.
                            Unit EB No.: <t t-out="u.own_eb_no or '—'"/>; Common EB No.: <t t-out="rec.property_id.common_eb_no or '—'"/>.
                            <t t-if="u.boundaries"><br/>Boundaries: <t t-out="u.boundaries"/>.</t>
                        </p>

                        <h4 style="color:#1c2e5c;">4. Rent &amp; Terms</h4>
                        <table style="width:100%;border-collapse:collapse;font-size:12px;">
                            <tr><td style="padding:4px;">Base Rent</td><td style="text-align:right;"><t t-out="rec.inr(cv.base_rent if cv else 0)"/></td></tr>
                            <tr t-if="cv and cv.discount"><td style="padding:4px;">Discount</td><td style="text-align:right;">- <t t-out="rec.inr(cv.discount)"/></td></tr>
                            <tr t-if="cv and cv.service_charge"><td style="padding:4px;">Service Charge</td><td style="text-align:right;">+ <t t-out="rec.inr(cv.service_charge)"/></td></tr>
                            <tr style="font-weight:800;border-top:1px solid #1c2e5c;"><td style="padding:4px;">Payable Rent</td><td style="text-align:right;"><t t-out="rec.inr(rec.payable_rent)"/></td></tr>
                        </table>
                        <p style="font-size:12px;line-height:1.6;">
                            Term: <t t-out="cv.start_date if cv else ''"/> to <t t-out="cv.end_date if cv else ''"/>.
                            Due Day: <t t-out="rec.due_day"/>. Notice Period: <t t-out="rec.notice_period_days"/> days.
                            Lock-in: <t t-out="rec.lockin_months"/> months.
                            Security Deposit: <t t-out="rec.inr(rec.advance_total)"/>.
                            Escalation: <t t-out="rec.escalation_pct"/>% every
                            <t t-out="dict(rec._fields['escalation_frequency'].selection).get(rec.escalation_frequency,'')"/>.<br/>
                            Default / Breach: <t t-out="rec.default_breach_text or ''"/>.
                        </p>

                        <h4 style="color:#1c2e5c;">5. Clauses</h4>
                        <t t-foreach="rec.template_id.clause_ids" t-as="cl">
                            <p style="font-size:12px;line-height:1.5;"><strong><t t-out="cl.name"/>.</strong>
                                <t t-out="cl.body or ''"/></p>
                        </t>
                        <t t-if="rec.agreement_notes">
                            <h4 style="color:#1c2e5c;">6. Special Notes</h4>
                            <p style="font-size:12px;"><t t-out="rec.agreement_notes"/></p>
                        </t>

                        <div style="display:flex;justify-content:space-between;margin-top:40px;font-size:12px;">
                            <div>Lessor: __________________<br/><t t-out="e.name"/></div>
                            <div style="text-align:right;">Lessee: __________________<br/><t t-out="ten.name"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
