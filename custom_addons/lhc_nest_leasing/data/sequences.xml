<?xml version="1.0" encoding="utf-8"?>
<!--
  Document sequences for this addon.

  Split out of the original data/sequences.xml so numbering ships with the
  model that consumes it. noupdate="1" is deliberate: an upgrade must never
  reset number_next, or the next receipt reuses a number already issued.
-->
<odoo noupdate="1">

    <record id="seq_lhc_agreement" model="ir.sequence">
        <field name="name">LHC Agreement</field>
        <field name="code">lhc.agreement</field>
        <field name="prefix">AGR-</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_lhc_vacate" model="ir.sequence">
        <field name="name">LHC Vacate</field>
        <field name="code">lhc.vacate</field>
        <field name="prefix">VAC-</field>
        <field name="padding">4</field>
    </record>

</odoo>
