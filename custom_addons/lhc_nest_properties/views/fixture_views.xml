<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_fixture_list" model="ir.ui.view">
        <field name="name">lhc.fixture.purchase.list</field>
        <field name="model">lhc.fixture.purchase</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="purchase_date"/>
                <field name="cost_before_gst"/>
                <field name="gst_bill"/>
                <field name="gst_amount"/>
                <field name="vendor"/>
                <field name="unit_id"/>
                <field name="status" widget="badge"
                       decoration-success="status=='assigned'"
                       decoration-warning="status=='unassigned'"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_fixture_form" model="ir.ui.view">
        <field name="name">lhc.fixture.purchase.form</field>
        <field name="model">lhc.fixture.purchase</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Item Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="quantity"/>
                            <field name="purchase_date"/>
                            <field name="cost_before_gst"/>
                            <field name="vendor"/>
                            <field name="move_in_condition"/>
                        </group>
                        <group>
                            <field name="gst_bill"/>
                            <field name="gst_amount" invisible="not gst_bill"/>
                            <field name="unit_id"/>
                            <field name="property_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Bill / Invoice">
                        <field name="bill_file" filename="bill_filename"/>
                        <field name="bill_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhc_fixture" model="ir.actions.act_window">
        <field name="name">Fixture Purchases</field>
        <field name="res_model">lhc.fixture.purchase</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
