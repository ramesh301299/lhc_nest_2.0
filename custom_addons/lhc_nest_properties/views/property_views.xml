<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_property_list" model="ir.ui.view">
        <field name="name">lhc.property.list</field>
        <field name="model">lhc.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="property_type"/>
                <field name="location"/>
                <field name="unit_count"/>
                <field name="occupied_count"/>
                <field name="vacant_count"/>
                <field name="common_eb_no"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_property_form" model="ir.ui.view">
        <field name="name">lhc.property.form</field>
        <field name="model">lhc.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Property Name"/></h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="property_type"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="common_eb_no"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Units">
                            <field name="unit_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="unit_type"/>
                                    <field name="area_sqft"/>
                                    <field name="own_eb_no"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lhc_property_kanban" model="ir.ui.view">
        <field name="name">lhc.property.kanban</field>
        <field name="model">lhc.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/><field name="code"/><field name="location"/>
                <field name="occupied_count"/><field name="vacant_count"/><field name="unit_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title"><strong><field name="name"/></strong></div>
                            <div class="text-muted"><field name="code"/> · <field name="location"/></div>
                            <div class="mt-2">
                                <span class="badge text-bg-success">Occupied: <field name="occupied_count"/></span>
                                <span class="badge text-bg-secondary">Vacant: <field name="vacant_count"/></span>
                                <span class="badge text-bg-info">Units: <field name="unit_count"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_lhc_property" model="ir.actions.act_window">
        <field name="name">Properties &amp; Units</field>
        <field name="res_model">lhc.property</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
