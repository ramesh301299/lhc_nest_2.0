<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_booking_list" model="ir.ui.view">
        <field name="name">lhc.booking.list</field>
        <field name="model">lhc.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="prospect_name"/>
                <field name="phone"/>
                <field name="token_amount"/>
                <field name="date_received"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_booking_form" model="ir.ui.view">
        <field name="name">lhc.booking.form</field>
        <field name="model">lhc.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="unit_id"/>
                            <field name="prospect_name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="token_amount"/>
                            <field name="date_received"/>
                            <field name="mode"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhc_booking" model="ir.actions.act_window">
        <field name="name">Book a Unit</field>
        <field name="res_model">lhc.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
