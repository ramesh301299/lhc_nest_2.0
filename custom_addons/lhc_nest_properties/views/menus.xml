<?xml version="1.0" encoding="utf-8"?>
<!-- Property menus. Parented to the group headers owned by lhc_nest, so installing this addon makes exactly these leaves appear and nothing else. -->
<odoo>
    <menuitem id="menu_lhc_properties" name="Properties &amp; Units" parent="lhc_nest.menu_lhc_property_grp"
              action="action_lhc_property"
              sequence="10"/>
    <menuitem id="menu_lhc_units" name="Units" parent="lhc_nest.menu_lhc_property_grp"
              action="action_lhc_unit"
              sequence="15"/>
    <menuitem id="menu_lhc_fixtures" name="Fixture Purchases" parent="lhc_nest.menu_lhc_property_grp"
              action="action_lhc_fixture"
              sequence="40"/>
    <menuitem id="menu_lhc_quick_book" name="Book a Unit" parent="lhc_nest.menu_lhc_quick"
              action="action_lhc_booking"
              sequence="30"/>
    <menuitem id="menu_lhc_quick_fixture" name="Log Fixture Purchase" parent="lhc_nest.menu_lhc_quick"
              action="action_lhc_fixture"
              sequence="50"/>
</odoo>
