<?xml version="1.0" encoding="utf-8"?>
<!-- The tenant master on its own. current_unit_id, status and the Agreements
     page are NOT here: those are lease-derived, and lhc_nest_leasing adds them
     back by inheriting these same views. That is what lets this addon install
     without leasing present. -->
<odoo>
    <record id="view_lhc_tenant_list" model="ir.ui.view">
        <field name="name">lhc.tenant.list</field>
        <field name="model">lhc.tenant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mobile"/>
                <field name="tenant_type"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_tenant_form" model="ir.ui.view">
        <field name="name">lhc.tenant.form</field>
        <field name="model">lhc.tenant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Full Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tenant_type"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="move_in_date"/>
                        </group>
                        <group string="Individual" invisible="tenant_type != 'individual'">
                            <field name="relation"/>
                            <field name="age"/>
                            <field name="aadhaar"/>
                            <field name="pan"/>
                        </group>
                        <group string="Company / GST" invisible="tenant_type != 'company'">
                            <field name="company_name"/>
                            <field name="gstin"/>
                        </group>
                    </group>
                    <group string="Addresses">
                        <field name="present_address"/>
                        <field name="permanent_address"/>
                    </group>
                    <group string="Authorized Representative" invisible="tenant_type != 'company'">
                        <group>
                            <field name="rep_name"/>
                            <field name="rep_relation"/>
                            <field name="rep_pan"/>
                        </group>
                        <group>
                            <field name="rep_aadhaar"/>
                            <field name="rep_mobile"/>
                            <field name="rep_address"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="photo_id_doc" filename="photo_id_filename"/>
                        <field name="photo_id_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhc_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">lhc.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
