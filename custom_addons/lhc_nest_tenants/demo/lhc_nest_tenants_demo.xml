<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Both tenant kinds, because they print differently on an agreement.

      An individual carries the S/o or W/o relation and their own Aadhaar; a
      company tenant carries a GSTIN and an authorised representative, and it is
      the representative's identity that goes into the Lessee block. A demo
      database with only individuals never exercises that second layout.

      move_in_date is left unset on purpose. lhc.agreement.action_confirm()
      stamps it from the lease start, and the leasing demo relies on that.
    -->

    <record id="demo_tenant_ravi" model="lhc.tenant">
        <field name="name">Ravi Shankar</field>
        <field name="tenant_type">individual</field>
        <field name="relation">S/o Anantharaman</field>
        <field name="age">38</field>
        <field name="aadhaar">4821 7734 9016</field>
        <field name="pan">AVBPR7742K</field>
        <field name="mobile">+91 98410 77321</field>
        <field name="email">ravi.shankar@example.com</field>
        <field name="present_address">Flat A-101, Lakeview Residency,
Second Main Road, Adyar,
Chennai 600020</field>
        <field name="permanent_address">32, Kamaraj Street,
Kumbakonam 612001</field>
    </record>

    <record id="demo_tenant_meena" model="lhc.tenant">
        <field name="name">Meena Lakshmi</field>
        <field name="tenant_type">individual</field>
        <field name="relation">W/o Prabhakaran</field>
        <field name="age">44</field>
        <field name="aadhaar">7710 4492 3358</field>
        <field name="pan">BQRPM1180L</field>
        <field name="mobile">+91 94440 20918</field>
        <field name="email">meena.lakshmi@example.com</field>
        <field name="present_address">Flat B-201, Lakeview Residency,
Second Main Road, Adyar,
Chennai 600020</field>
    </record>

    <!-- Company tenant: GSTIN plus an authorised representative. This is the
         one whose lease bills through the GST entity and produces Tax
         Invoices rather than rent receipts. -->
    <record id="demo_tenant_acme" model="lhc.tenant">
        <field name="name">Acme Retail Solutions Pvt Ltd</field>
        <field name="tenant_type">company</field>
        <field name="company_name">Acme Retail Solutions Private Limited</field>
        <field name="gstin">33AACCA9921F1ZP</field>
        <field name="mobile">+91 44 4210 9900</field>
        <field name="email">accounts@acmeretail.example.com</field>
        <field name="pan">AACCA9921F</field>
        <field name="present_address">Shop S-01, Lakeview Residency,
Second Main Road, Adyar,
Chennai 600020</field>
        <field name="rep_name">Sujatha Narayanan</field>
        <field name="rep_relation">Authorised Signatory / Director</field>
        <field name="rep_pan">AJKPS3390M</field>
        <field name="rep_aadhaar">9021 5540 7783</field>
        <field name="rep_mobile">+91 98407 33218</field>
        <field name="rep_address">7B, Rajaji Salai,
Mylapore, Chennai 600004</field>
    </record>

    <!-- An archived tenant, so the Archived filter has something to find and
         the soft-delete rule (spec 4.6) is visible rather than theoretical. -->
    <record id="demo_tenant_former" model="lhc.tenant">
        <field name="name">Gopinath Venkatesh</field>
        <field name="tenant_type">individual</field>
        <field name="relation">S/o Venkatesh</field>
        <field name="mobile">+91 90030 11447</field>
        <field name="pan">CDEPG7712N</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
