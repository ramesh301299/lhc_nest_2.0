<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_billing_entity_list" model="ir.ui.view">
        <field name="name">lhc.billing.entity.list</field>
        <field name="model">lhc.billing.entity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="gst_applicable" widget="boolean_toggle"/>
                <field name="receipt_type"/>
                <field name="gstin"/>
                <field name="pan"/>
                <field name="bank_label"/>
                <field name="also_receives_building"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_billing_entity_form" model="ir.ui.view">
        <field name="name">lhc.billing.entity.form</field>
        <field name="model">lhc.billing.entity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Entity Name"/></h1>
                    </div>
                    <group>
                        <group string="GST">
                            <field name="gst_applicable"/>
                            <field name="gstin" invisible="not gst_applicable"/>
                            <field name="receipt_type"/>
                            <field name="also_receives_building"/>
                        </group>
                        <group string="Identity (Lessor block)">
                            <field name="relation"/>
                            <field name="age"/>
                            <field name="aadhaar"/>
                            <field name="pan"/>
                            <field name="mobile"/>
                        </group>
                    </group>
                    <group string="Residential Address">
                        <field name="residential_address" nolabel="1"/>
                    </group>
                    <group string="Bank Account (printed verbatim on agreements)">
                        <group>
                            <field name="bank_holder_name"/>
                            <field name="bank_account_no"/>
                            <field name="bank_name"/>
                        </group>
                        <group>
                            <field name="bank_branch"/>
                            <field name="bank_branch_address"/>
                            <field name="bank_ifsc"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhc_billing_entity" model="ir.actions.act_window">
        <field name="name">Billing Entities</field>
        <field name="res_model">lhc.billing.entity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a billing entity</p>
            <p>GST applicability is a property of the entity — only the GST entity issues Tax Invoices.</p>
        </field>
    </record>

    <record id="view_lhc_billing_entity_kanban" model="ir.ui.view">
        <field name="name">lhc.billing.entity.kanban.lhc</field>
        <field name="model">lhc.billing.entity</field>
        <field name="arch" type="xml">
            <kanban records_draggable="0">
                <field name="gst_applicable"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <span class="lhc-card-title text-truncate"><field name="name"/></span>
                                <!-- gst_applicable is a Boolean. widget="badge"
                                     only handles char/selection/many2one; on a
                                     boolean Odoo falls back to the checkbox
                                     widget, whose markup leaked into the card as
                                     text and forced the title to wrap one letter
                                     per line. A plain conditional label says the
                                     same thing and cannot misrender. -->
                                <span class="badge text-bg-warning flex-shrink-0"
                                      t-if="record.gst_applicable.raw_value">GST Registered</span>
                                <span class="badge text-bg-secondary flex-shrink-0"
                                      t-else="">Non-GST</span>
                            </div>
                            <div class="lhc-card-row">
                                <span class="lhc-k">PAN</span>
                                <span class="lhc-v"><field name="pan"/></span>
                            </div>
                            <div class="lhc-card-row" t-if="record.gst_applicable.raw_value">
                                <span class="lhc-k">GSTIN</span>
                                <span class="lhc-v"><field name="gstin"/></span>
                            </div>
                            <div class="lhc-card-row">
                                <span class="lhc-k">Receipt Type</span>
                                <span class="lhc-v"><field name="receipt_type"/></span>
                            </div>
                            <div class="lhc-card-row">
                                <span class="lhc-k">Linked Bank</span>
                                <span class="lhc-v"><field name="bank_label"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
