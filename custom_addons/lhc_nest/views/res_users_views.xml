<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      The web "My Profile" flow, extended to the four details LHC NEST treats
      as a person's profile.

      Odoo's Preferences dialog already owns self-service profile editing: it
      writes through `res.users.write()`, which escalates to superuser only for
      the fields on SELF_WRITEABLE_FIELDS. `lhc_nest.models.res_users` adds
      `phone` and `function` to that list, and this view is what puts them in
      front of the user — the same four fields, with the same permission rule,
      that `POST /api/mobile/profile` serves to the Flutter app.

      `name` is unlocked deliberately. It is on Odoo's own SELF_WRITEABLE_FIELDS
      (so a user has always been allowed to change it), but the stock dialog
      renders it read-only, which would have left the mobile app offering an
      edit the web app refused. One rule, both clients.
    -->
    <record id="view_users_form_simple_modif_lhc_profile" model="ir.ui.view">
        <field name="name">res.users.preferences.form.lhc.profile</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">

            <!-- Full Name — editable, as it is in the mobile Edit Profile screen. -->
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="placeholder">Your name</attribute>
            </xpath>

            <!-- Designation and Phone, beside the email that is already here. -->
            <xpath expr="//field[@name='email']" position="after">
                <field name="function" string="Designation" readonly="0"
                       placeholder="e.g. Owner · Admin"/>
                <field name="phone" widget="phone" readonly="0"
                       placeholder="e.g. +91 98765 43210"/>
            </xpath>

        </field>
    </record>
</odoo>
