<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      A fifth billing entity, for demo databases only.

      The four in data/billing_entity_data.xml are the real lessors and are
      noupdate="1" so an administrator's corrections survive an upgrade. This
      one exists so the entity screens can be exercised — created, edited,
      archived — without touching a record the receipts and agreements point at.

      Deliberately non-GST: spec §3 makes Soundarajan Kumar the only GST entity,
      and a second GST entity in a demo database is how that invariant quietly
      stops being true.
    -->
    <record id="demo_entity_lakeview" model="lhc.billing.entity">
        <field name="name">Lakeview Holdings (Demo)</field>
        <field name="gst_applicable" eval="False"/>
        <field name="relation">S/o Ramanathan</field>
        <field name="age">54</field>
        <field name="pan">AAAAL4455D</field>
        <field name="mobile">+91 98400 11223</field>
        <field name="residential_address">14, Second Main Road,
Gandhi Nagar, Adyar,
Chennai 600020</field>
        <field name="bank_holder_name">Lakeview Holdings</field>
        <field name="bank_account_no">000000007731</field>
        <field name="bank_name">Axis</field>
        <field name="bank_branch">Adyar</field>
        <field name="bank_branch_address">L.B. Road, Adyar, Chennai 600020</field>
        <field name="bank_ifsc">UTIB0000123</field>
    </record>

</odoo>
