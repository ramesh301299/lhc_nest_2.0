<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Record rules for this addon's models — company scoping and ledger
      visibility in one file, per the suite convention.

      noupdate="0" throughout. A rule is the security model, not an
      administrator preference, so a correction to one has to reach databases
      that already installed the old version. The ledger rules below were
      previously noupdate="1", which meant a fix to the closed-month domain sat
      unapplied on every database that had already installed it.

      global="True" means the rule is ANDed with every other rule regardless of
      group, so no group membership can widen it. The group-scoped rules below
      are ORed among themselves and then ANDed with the global ones.
    -->
    <data noupdate="0">

        <!-- ==========================================================
             MULTI-COMPANY

             Every money document belongs to the company that collected or
             spent. Global, so these AND with the ledger rules below.
             ========================================================== -->

        <record id="rule_lhc_receipt_company" model="ir.rule">
            <field name="name">Receipt: multi-company</field>
            <field name="model_id" ref="model_lhc_receipt"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_ledger_entry_company" model="ir.rule">
            <field name="name">Ledger Entry: multi-company</field>
            <field name="model_id" ref="model_lhc_ledger_entry"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_bill_company" model="ir.rule">
            <field name="name">Bill: multi-company</field>
            <field name="model_id" ref="model_lhc_bill"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhc_maintenance_company" model="ir.rule">
            <field name="name">Maintenance: multi-company</field>
            <field name="model_id" ref="model_lhc_maintenance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ==========================================================
             LEDGER VISIBILITY

             A fully-cleared month is archived from the Accountant's view: they
             see the current open month and anything still outstanding, the
             Admin sees all of it. A row-level rule rather than a field or menu
             restriction, because the distinction is per-record, not per-screen.
             ========================================================== -->

        <record id="rule_ledger_accountant_open" model="ir.rule">
            <field name="name">Accountant: hide closed-month ledger entries</field>
            <field name="model_id" ref="model_lhc_ledger_entry"/>
            <field name="groups" eval="[(4, ref('lhc_nest.group_lhc_accountant'))]"/>
            <field name="domain_force">[('is_closed_month','=',False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin implies Accountant, so without this rule an Admin would
             inherit the Accountant's closed-month restriction. Group rules are
             ORed, so granting the whole set back here is what widens it. -->
        <record id="rule_ledger_admin_all" model="ir.rule">
            <field name="name">Admin: all ledger entries</field>
            <field name="model_id" ref="model_lhc_ledger_entry"/>
            <field name="groups" eval="[(4, ref('lhc_nest.group_lhc_admin'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

    </data>
</odoo>
