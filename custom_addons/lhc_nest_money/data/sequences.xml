<?xml version="1.0" encoding="utf-8"?>
<!--
  Document sequences for this addon.

  Split out of the original data/sequences.xml so numbering ships with the
  model that consumes it. noupdate="1" is deliberate: an upgrade must never
  reset number_next, or the next receipt reuses a number already issued.
-->
<odoo noupdate="1">

    <record id="seq_lhc_gst_invoice" model="ir.sequence">
        <field name="name">LHC GST Tax Invoice</field>
        <field name="code">lhc.gst.invoice</field>
        <field name="prefix">GST/%(y)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_lhc_receipt_nongst" model="ir.sequence">
        <field name="name">LHC Non-GST Receipt</field>
        <field name="code">lhc.receipt.nongst</field>
        <field name="prefix">RCPT/%(y)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_lhc_bill_proforma" model="ir.sequence">
        <field name="name">LHC Proforma Invoice</field>
        <field name="code">lhc.bill.proforma</field>
        <field name="prefix">PRO/%(y)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_lhc_maintenance" model="ir.sequence">
        <field name="name">LHC Maintenance</field>
        <field name="code">lhc.maintenance</field>
        <field name="prefix">MNT-</field>
        <field name="padding">4</field>
    </record>

</odoo>
