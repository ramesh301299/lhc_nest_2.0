<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lhc_bill" model="ir.actions.report">
        <field name="name">Proforma / Tax Invoice</field>
        <field name="model">lhc.bill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lhc_nest.report_bill</field>
        <field name="report_file">lhc_nest.report_bill</field>
        <field name="binding_model_id" ref="model_lhc_bill"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rec">
                <t t-set="entity" t-value="rec.billing_entity_id"/>
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:Arial,sans-serif;color:#1e293b;max-width:640px;margin:0 auto;">
                        <div style="border:1px solid #e2e8f0;border-radius:12px;padding:26px;">
                            <div style="text-align:center;border-bottom:2px solid #1c2e5c;padding-bottom:12px;margin-bottom:14px;">
                                <div style="font-size:18px;font-weight:800;color:#1c2e5c;"><t t-out="entity.name"/> — Rental Services</div>
                                <div style="font-size:11px;color:#64748b;">
                                    <t t-if="rec.gst_applicable">GSTIN: <t t-out="entity.gstin or ''"/></t>
                                    <t t-else="">PAN: <t t-out="entity.pan or ''"/> · Non-GST</t>
                                </div>
                                <div style="font-size:11px;letter-spacing:.1em;color:#64748b;margin-top:8px;">
                                    <t t-if="rec.doc_type == 'tax'">TAX INVOICE (BEFORE PAYMENT)</t>
                                    <t t-else="">PROFORMA INVOICE — ESTIMATE ONLY</t>
                                </div>
                            </div>
                            <table style="width:100%;margin:10px 0;border-bottom:1px solid #e2e8f0;padding-bottom:10px;">
                                <tr>
                                    <td><div style="font-size:10px;color:#94a3b8;">Document No.</div>
                                        <div style="font-weight:700;"><t t-out="rec.name"/></div></td>
                                    <td style="text-align:right;"><div style="font-size:10px;color:#94a3b8;">Period</div>
                                        <div style="font-weight:600;"><t t-out="rec.period or ''"/></div></td>
                                </tr>
                            </table>
                            <div style="font-size:12px;margin-bottom:8px;"><strong>Billed To:</strong>
                                <t t-out="rec.tenant_id.name"/> — Unit <t t-out="rec.unit_id.code"/></div>
                            <table style="width:100%;border-collapse:collapse;">
                                <tbody>
                                    <tr><td style="padding:6px;font-size:12px;">Rent — <t t-out="rec.period or ''"/></td>
                                        <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.rent_amount)"/></td></tr>
                                    <tr t-if="rec.gst_applicable"><td style="padding:6px;font-size:12px;">GST @<t t-out="rec.gst_rate"/>%</td>
                                        <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.gst_amount)"/></td></tr>
                                    <tr t-if="rec.maintenance_amount"><td style="padding:6px;font-size:12px;">Maintenance recovery (no GST)</td>
                                        <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.maintenance_amount)"/></td></tr>
                                </tbody>
                            </table>
                            <div style="display:flex;justify-content:space-between;font-weight:800;font-size:16px;border-top:2px solid #1c2e5c;padding-top:10px;margin-top:8px;">
                                <span>Total Due</span><span><t t-out="rec.inr(rec.total)"/></span></div>
                            <div style="margin-top:14px;font-size:10.5px;color:#94a3b8;text-align:center;border-top:1px dashed #e2e8f0;padding-top:8px;">
                                <t t-if="rec.doc_type == 'proforma'">This is a proforma estimate, not a tax document. Payment is due before occupancy/period as agreed.</t>
                                <t t-else="">Tax Invoice raised before payment. On receipt of payment the same number is retained on the final receipt.</t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
