<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lhc_receipt" model="ir.actions.report">
        <field name="name">Rent Receipt / Tax Invoice</field>
        <field name="model">lhc.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lhc_nest.report_receipt</field>
        <field name="report_file">lhc_nest.report_receipt</field>
        <field name="binding_model_id" ref="model_lhc_receipt"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rec">
                <t t-set="cv" t-value="rec.agreement_id.current_version_id"/>
                <t t-set="entity" t-value="rec.billing_entity_id"/>
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:Arial,sans-serif;color:#1e293b;max-width:640px;margin:0 auto;">
                        <div style="border:1px solid #e2e8f0;border-radius:12px;padding:26px;">

                            <!-- ============ GST TAX INVOICE ============ -->
                            <t t-if="rec.gst_applicable">
                                <div style="text-align:center;border-bottom:2px solid #1c2e5c;padding-bottom:12px;margin-bottom:14px;">
                                    <div style="font-size:18px;font-weight:800;color:#1c2e5c;">
                                        <t t-out="entity.name"/> — Rental Services</div>
                                    <div style="font-size:11px;color:#64748b;">GSTIN: <t t-out="entity.gstin or ''"/></div>
                                    <div style="font-size:11px;letter-spacing:.1em;color:#64748b;margin-top:8px;">TAX INVOICE</div>
                                </div>
                                <table style="width:100%;margin:10px 0;border-bottom:1px solid #e2e8f0;padding-bottom:10px;">
                                    <tr>
                                        <td><div style="font-size:10px;color:#94a3b8;">Invoice No.</div>
                                            <div style="font-weight:700;"><t t-out="rec.name"/></div></td>
                                        <td style="text-align:right;"><div style="font-size:10px;color:#94a3b8;">Date</div>
                                            <div style="font-weight:600;"><t t-out="rec.receipt_date"/></div></td>
                                    </tr>
                                </table>
                                <div style="font-size:12px;margin-bottom:8px;"><strong>Billed To:</strong>
                                    <t t-out="rec.tenant_id.name"/> — Unit <t t-out="rec.unit_id.code"/>,
                                    <t t-out="rec.property_id.name"/></div>
                                <table style="width:100%;border-collapse:collapse;">
                                    <thead><tr>
                                        <th style="text-align:left;font-size:10.5px;color:#94a3b8;padding:6px;border-bottom:1px solid #e2e8f0;">Description</th>
                                        <th style="text-align:right;font-size:10.5px;color:#94a3b8;padding:6px;border-bottom:1px solid #e2e8f0;">Amount</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr><td style="padding:6px;font-size:12px;">Rental Income — <t t-out="rec.period or ''"/> (Unit <t t-out="rec.unit_id.code"/>)</td>
                                            <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.rent_amount)"/></td></tr>
                                        <tr><td style="padding:6px;font-size:12px;">CGST @<t t-out="rec.gst_rate/2"/>%</td>
                                            <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.gst_amount/2.0)"/></td></tr>
                                        <tr><td style="padding:6px;font-size:12px;">SGST @<t t-out="rec.gst_rate/2"/>%</td>
                                            <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.gst_amount/2.0)"/></td></tr>
                                        <tr t-if="rec.maintenance_amount">
                                            <td style="padding:6px;font-size:12px;">Maintenance recovery (no GST)</td>
                                            <td style="text-align:right;padding:6px;"><t t-out="rec.inr(rec.maintenance_amount)"/></td></tr>
                                    </tbody>
                                </table>
                                <div style="display:flex;justify-content:space-between;font-weight:800;font-size:16px;border-top:2px solid #1c2e5c;padding-top:10px;margin-top:8px;">
                                    <span>Total</span><span><t t-out="rec.inr(rec.total_invoice)"/></span></div>
                                <t t-if="rec.tds_applicable">
                                    <div style="display:flex;justify-content:space-between;font-size:11.5px;color:#64748b;margin-top:4px;">
                                        <span>Less: TDS Deducted<t t-if="rec.tds_challan"> (Challan <t t-out="rec.tds_challan"/>)</t></span>
                                        <span>- <t t-out="rec.inr(rec.tds_amount)"/></span></div>
                                    <div style="display:flex;justify-content:space-between;font-size:12.5px;font-weight:700;color:#16a34a;margin-top:2px;">
                                        <span>Net Amount Received</span><span><t t-out="rec.inr(rec.amount_received_bank)"/></span></div>
                                </t>
                                <div style="display:flex;justify-content:space-between;margin-top:26px;font-size:11px;">
                                    <div>Received By: __________</div>
                                    <div style="text-align:right;">For <t t-out="entity.name"/> Rental Services<br/><br/>Authorised Signatory</div>
                                </div>
                            </t>

                            <!-- ============ NON-GST RENT RECEIPT ============ -->
                            <t t-else="">
                                <div style="text-align:center;border-bottom:2px solid #1c2e5c;padding-bottom:12px;margin-bottom:14px;">
                                    <div style="font-size:18px;font-weight:800;color:#1c2e5c;">
                                        <t t-out="entity.name"/> — Rental Services</div>
                                    <div style="font-size:11px;color:#64748b;">PAN: <t t-out="entity.pan or ''"/> · Non-GST</div>
                                    <div style="font-size:11px;letter-spacing:.1em;color:#64748b;margin-top:8px;">RENT RECEIPT</div>
                                </div>
                                <table style="width:100%;margin:10px 0;border-bottom:1px solid #e2e8f0;padding-bottom:10px;">
                                    <tr>
                                        <td><div style="font-size:10px;color:#94a3b8;">Receipt No.</div>
                                            <div style="font-weight:700;"><t t-out="rec.name"/></div></td>
                                        <td style="text-align:right;"><div style="font-size:10px;color:#94a3b8;">Date</div>
                                            <div style="font-weight:600;"><t t-out="rec.receipt_date"/></div></td>
                                    </tr>
                                </table>
                                <div style="margin-bottom:14px;font-size:12.5px;">Received from
                                    <strong><t t-out="rec.tenant_id.name"/></strong>, tenant of
                                    <strong>Unit <t t-out="rec.unit_id.code"/>, <t t-out="rec.property_id.name"/></strong>, the sum of:</div>
                                <div style="background:#f8fafc;border-radius:8px;padding:14px;margin-bottom:14px;">
                                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
                                        <span>Base Rent</span><span><t t-out="rec.inr(cv.base_rent if cv else rec.rent_amount)"/></span></div>
                                    <div t-if="cv and cv.discount" style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;color:#dc2626;">
                                        <span>Discount</span><span>- <t t-out="rec.inr(cv.discount)"/></span></div>
                                    <div t-if="cv and cv.service_charge" style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;color:#334155;">
                                        <span>Service Charge</span><span>+ <t t-out="rec.inr(cv.service_charge)"/></span></div>
                                    <div t-if="rec.maintenance_amount" style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
                                        <span>Maintenance recovery</span><span>+ <t t-out="rec.inr(rec.maintenance_amount)"/></span></div>
                                    <div style="border-top:2px solid #1c2e5c;padding-top:8px;display:flex;justify-content:space-between;font-size:15px;font-weight:800;">
                                        <span>Amount Received</span><span><t t-out="rec.inr(rec.amount_received_bank)"/></span></div>
                                </div>
                                <div style="font-size:12px;color:#64748b;margin-bottom:12px;">
                                    Period: <strong><t t-out="rec.period or ''"/></strong> · Mode: <t t-out="rec.payment_mode"/> · Bank: <t t-out="rec.bank_label or ''"/></div>
                                <div style="display:flex;justify-content:space-between;margin-top:20px;font-size:11px;">
                                    <div><strong>Tenant Signature:</strong> __________________</div>
                                    <div style="text-align:right;"><strong>For <t t-out="entity.name"/> Rental Services</strong><br/><br/>Authorised Signatory</div>
                                </div>
                                <div style="margin-top:10px;font-size:10px;color:#94a3b8;text-align:center;border-top:1px dashed #e2e8f0;padding-top:8px;">
                                    This is a non-GST receipt. No GST is charged on this transaction — <t t-out="entity.name"/> is not a GST-registered entity.</div>
                            </t>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
