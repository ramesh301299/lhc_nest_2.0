<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_wa_template_list" model="ir.ui.view">
        <field name="name">lhc.wa.template.list</field>
        <field name="model">lhc.wa.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_type"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_wa_template_form" model="ir.ui.view">
        <field name="name">lhc.wa.template.form</field>
        <field name="model">lhc.wa.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Phase 1 is copy-paste only — the system never sends WhatsApp/SMS/email automatically (spec §5.6).
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="template_type"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhc_wa_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">lhc.wa.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
