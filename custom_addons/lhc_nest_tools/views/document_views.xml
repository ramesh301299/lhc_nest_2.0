<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mirrors the Documents screen: Category | File | Linked To | Uploaded | Actions.
         The binary widget renders the download control the screen's 📥 button stands for. -->
    <record id="view_lhc_document_list" model="ir.ui.view">
        <field name="name">lhc.document.list</field>
        <field name="model">lhc.document</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="category" widget="badge"
                       decoration-info="category == 'agreement'"
                       decoration-success="category == 'id_proof'"
                       decoration-warning="category == 'deposit_receipt'"/>
                <field name="name"/>
                <field name="file" filename="file_name" widget="binary" string="File"/>
                <field name="linked_to"/>
                <field name="upload_date"/>
                <field name="uploaded_by" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_lhc_document_form" model="ir.ui.view">
        <field name="name">lhc.document.form</field>
        <field name="model">lhc.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ravi_Aadhaar.pdf"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="category"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="note" placeholder="Optional note…"/>
                        </group>
                        <group string="Linked To">
                            <!-- At least one is required; the constraint explains why. -->
                            <field name="tenant_id"/>
                            <field name="unit_id"/>
                            <field name="agreement_id"/>
                            <field name="property_id"/>
                        </group>
                        <group string="Upload">
                            <field name="upload_date"/>
                            <field name="uploaded_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lhc_document_search" model="ir.ui.view">
        <field name="name">lhc.document.search</field>
        <field name="model">lhc.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name" string="Title or file"
                       filter_domain="['|', ('name', 'ilike', self), ('file_name', 'ilike', self)]"/>
                <field name="linked_to"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="agreement_id"/>
                <filter name="cat_agreement" string="Agreements"
                        domain="[('category', '=', 'agreement')]"/>
                <filter name="cat_id_proof" string="ID Proofs"
                        domain="[('category', '=', 'id_proof')]"/>
                <filter name="cat_deposit" string="Deposit Receipts"
                        domain="[('category', '=', 'deposit_receipt')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_tenant" string="Tenant"
                            context="{'group_by': 'tenant_id'}"/>
                    <filter name="group_unit" string="Unit"
                            context="{'group_by': 'unit_id'}"/>
                    <filter name="group_date" string="Upload Month"
                            context="{'group_by': 'upload_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lhc_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">lhc.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lhc_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload a document</p>
            <p>Agreements, ID proofs and deposit receipts, linked to the tenant,
               unit, agreement or property they belong to.</p>
        </field>
    </record>

</odoo>
