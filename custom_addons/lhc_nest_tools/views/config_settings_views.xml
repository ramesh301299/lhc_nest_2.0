<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhc_config_settings" model="ir.ui.view">
        <field name="name">lhc.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="LHC NEST" name="lhc_nest" logo="/lhc_nest/static/description/icon.png">
                    <block title="Billing &amp; GST" name="lhc_billing">
                        <setting string="GST Rate" help="Single source of truth GST rate used everywhere">
                            <field name="lhc_gst_rate"/> %
                        </setting>
                        <setting string="Reminder Anchor Day"
                                 help="Day of month rent reminders anchor on (spec §4.4)">
                            <field name="lhc_reminder_day"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_lhc_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'lhc_nest'}</field>
    </record>
</odoo>
